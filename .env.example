# ===================================================================
# Environment Variables for Production Deployment
# Copy this file as .env and fill in actual values.
# DO NOT commit the .env file to version control!
# ===================================================================

# === Render Backend ===
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# PostgreSQL (Render provides these automatically when you link a DB)
DATABASE_URL=jdbc:postgresql://host:5432/personalized_learning_db
DATABASE_USERNAME=learnpredict_user
DATABASE_PASSWORD=your_secure_password_here

# CORS - Set to your actual Vercel frontend URL
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# JVM Tuning
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Optional: Override thresholds
# WEAK_THRESHOLD=60.0
# STRONG_THRESHOLD=75.0

# === Vercel Frontend ===
# These are set in the Vercel dashboard or via vercel CLI:
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id
